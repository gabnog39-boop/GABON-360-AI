{
  "version": 1,
  "policy": {
    "live_only_when_connected": true,
    "simulation_never_presented_as_live": true,
    "state_authorization_required_for_protected_sources": true
  },
  "providers": {
    "open_meteo": {
      "enabled": true,
      "class": "public_weather",
      "base_url": "https://api.open-meteo.com/v1/forecast",
      "status": "connectable_now",
      "auth_required": false,
      "purpose": "weather_forecast_and_current_conditions"
    },
    "openstreetmap": {
      "enabled": true,
      "class": "public_basemap",
      "tile_url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "status": "connectable_now",
      "auth_required": false,
      "purpose": "base_map_only"
    },
    "device_location": {
      "enabled": true,
      "class": "device_sensor",
      "status": "connectable_now",
      "auth_required": "device_permission",
      "purpose": "authorized_device_position"
    },
    "network_health": {
      "enabled": true,
      "class": "local_health",
      "status": "connectable_now",
      "auth_required": false,
      "purpose": "api_connectivity_and_sync_health"
    },
    "official_gis": {
      "enabled": false,
      "class": "protected_official_source",
      "status": "awaiting_state_authorization_and_endpoint",
      "auth_required": true,
      "purpose": "official_boundaries_parks_roads_waterways_and_authorized_layers"
    },
    "satellite_feeds": {
      "enabled": false,
      "class": "protected_observation_source",
      "status": "awaiting_authorization_and_provider_contract",
      "auth_required": true,
      "purpose": "authorized_remote_observation"
    },
    "drone_feeds": {
      "enabled": false,
      "class": "protected_observation_source",
      "status": "awaiting_state_authorization_and_device_gateway",
      "auth_required": true,
      "purpose": "authorized_drone_observation"
    },
    "government_cameras": {
      "enabled": false,
      "class": "protected_government_source",
      "status": "awaiting_state_authorization_and_secure_gateway",
      "auth_required": true,
      "purpose": "authorized_video_observation"
    },
    "border_security_systems": {
      "enabled": false,
      "class": "protected_security_source",
      "status": "awaiting_state_authorization_and_secure_gateway",
      "auth_required": true,
      "purpose": "authorized_border_events_and_alerts"
    }
  }
}
